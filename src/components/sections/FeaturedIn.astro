---
import Container from '../ui/Container.astro';
---

<section class="pb-[clamp(56px,7vw,96px)] bg-sand" aria-label="Featured in">
  <Container>
    <ul class="flex flex-wrap items-center justify-center gap-x-[clamp(32px,5vw,72px)] gap-y-6 dashed-rule-y py-[clamp(36px,5vw,64px)] text-subtle">
      <li class="text-[17px] font-bold tracking-[0.02em]">BUSINESS INSIDER</li>
      <li class="text-[22px] font-bold tracking-[-0.03em] italic">
        yahoo!<span class="text-[17px] font-medium">finance</span>
      </li>
      <li class="text-sm font-bold tracking-[0.14em]">TECH NEWS</li>
      <li class="text-[19px] font-medium tracking-[-0.02em]">HyperAI</li>
      <li class="font-serif text-xl italic">Jingletree</li>
    </ul>
  </Container>
</section>

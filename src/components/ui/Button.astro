---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'outline' | 'light' | 'invert';
type Size = 'md' | 'sm';

interface Props extends HTMLAttributes<'a'> {
  variant?: Variant;
  size?: Size;
  block?: boolean;
}

const { variant = 'primary', size = 'md', block = false, class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-ink text-white hover:bg-ink-hover hover:text-white',
  outline: 'bg-white text-ink hover:text-ink',
  light: 'bg-white text-ink hover:bg-canvas hover:text-ink',
  invert: 'bg-white text-ink hover:bg-lime hover:text-ink',
};

const sizes: Record<Size, string> = {
  md: 'h-[46px] min-w-[220px] px-7 text-[15px]',
  sm: 'h-10 px-4 text-sm',
};
---

<a
  class:list={[
    'items-center justify-center gap-2 rounded-full font-semibold whitespace-nowrap shadow-soft transition-[color,background-color,box-shadow] hover:shadow-soft-hover',
    block ? 'flex w-full' : 'inline-flex',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>

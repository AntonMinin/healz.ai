---
import '@/styles/global.css';

import { Font, getImage } from 'astro:assets';

import ogSource from '@/assets/images/finish-hike.jpg';
import logo from '@/assets/logos/healz.svg';
import { site } from '@/config/site';
import { buildStructuredData } from '@/lib/structuredData';
import { absoluteUrl, withBase } from '@/lib/url';

const canonical = absoluteUrl(withBase(), Astro.site);
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = absoluteUrl(og.src, Astro.site);
const structuredData = JSON.stringify(
  buildStructuredData({
    page: canonical,
    logo: absoluteUrl(logo.src, Astro.site),
    image: ogImage,
  }),
).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content={site.legalName} />

    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="alternate" type="text/markdown" href={withBase('llms.txt')} title="LLM summary" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A man back to hiking after cancer treatment" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-dm-sans" preload />
    <script type="application/ld+json" is:inline set:html={structuredData} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 bg-ink px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
